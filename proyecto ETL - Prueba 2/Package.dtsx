    <DTS:Executable
      DTS:refId="Package\Tiempo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{0DCDF3A7-3C9E-4D39-9E4F-7560B1BA4E88}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tiempo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6EE53506-BF2A-4FC8-9815-958CFACFF439}"
          SQLTask:SqlStatementSource="&#xA;--Declaramos variables para cada campo&#xA;DECLARE @FECHA AS SMALLDATETIME&#xA;DECLARE @ANIO AS CHAR(4)&#xA;DECLARE @TRIMESTRE AS CHAR(10)&#xA;DECLARE @SEMESTRE AS CHAR(10)&#xA;DECLARE @MES AS SMALLINT&#xA;DECLARE @MES_LETRA AS CHAR(10)&#xA;DECLARE @SEMANA  AS CHAR(10)&#xA;DECLARE @DIA AS CHAR(10)&#xA;DECLARE @HORA AS CHAR(2)&#xA;DECLARE @MINUTO AS CHAR(2)&#xA;DECLARE @SEGUNDOS AS CHAR(2)&#xA;DECLARE @MILISEGUNDOS AS CHAR(2)&#xA;DECLARE @FECHA_DESDE AS SMALLDATETIME &#xA;DECLARE @FECHA_HASTA AS SMALLDATETIME&#xA;&#xA;&#xA;&#xA;BEGIN TRANSACTION&#xA;&#xA;&#x9;--Definir las fechas de inicio y termino&#xA;&#x9;--Inicio: 01/01/2013&#xA;&#x9;--Termino: 31/12/2018&#xA;&#xA;&#x9;SELECT @FECHA_DESDE = CAST('01/01/2013' AS SMALLDATETIME)&#xA;&#x9;SELECT @FECHA_HASTA = CAST('12/31/2018' AS SMALLDATETIME)&#xA;&#xA;&#x9;--Ciclo para insertar cada uno de los registros&#xA;&#x9;WHILE (@FECHA_DESDE &lt;= @FECHA_HASTA) BEGIN&#xA;&#xA;&#x9;&#x9;--Guardamos en cada variable el Valor&#xA;&#x9;&#x9;SELECT @FECHA = @FECHA_DESDE&#xA;&#x9;&#x9;SELECT @ANIO = DATEPART(YYYY, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @TRIMESTRE = DATEPART(QUARTER, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @FECHA_DESDE = DATEADD(DAY, 1, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @SEMESTRE = ((DATEPART(MM, @FECHA_DESDE) -1 ) / 6 ) + 1&#xA;&#x9;&#x9;SELECT @MES = DATEPART(MM, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @MES_LETRA = DATENAME(MM, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @SEMANA =  DATEPART(WEEK, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @DIA = DATEPART(DD, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @HORA = DATEPART(HH, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @MINUTO = DATEPART(N, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @SEGUNDOS = DATEPART(SS, @FECHA_DESDE)&#xA;&#x9;&#x9;SELECT @MILISEGUNDOS = DATEPART(MS, @FECHA_DESDE)&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;INSERT INTO &#xA;&#x9;&#x9;Bikez_DW.DBO.DIM_TIEMPO &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;Fecha,&#xA;&#x9;&#x9;Anio,&#xA;&#x9;&#x9;Trimestre,&#xA;&#x9;&#x9;Semestre,&#xA;&#x9;&#x9;Mes,&#xA;&#x9;&#x9;Mes_Letra,&#xA;&#x9;&#x9;Semana,&#xA;&#x9;&#x9;Dia,&#xA;&#x9;&#x9;Hora,&#xA;&#x9;&#x9;Minuto,&#xA;&#x9;&#x9;Segundos,&#xA;&#x9;&#x9;Milisegundos&#xA;&#x9;&#x9;) &#xA;&#x9;&#x9;&#xA;&#x9;&#x9;VALUES&#xA;&#x9;&#x9;( &#xA;&#x9;&#x9;@FECHA,&#xA;&#x9;&#x9;@ANIO,&#xA;&#x9;&#x9;@TRIMESTRE,&#xA;&#x9;&#x9;@SEMESTRE,&#xA;&#x9;&#x9;@MES,&#xA;&#x9;&#x9;@MES_LETRA,&#xA;&#x9;&#x9;@SEMANA,&#xA;&#x9;&#x9;@DIA,&#xA;&#x9;&#x9;@HORA,&#xA;&#x9;&#x9;@MINUTO,&#xA;&#x9;&#x9;@SEGUNDOS,&#xA;&#x9;&#x9;@MILISEGUNDOS&#xA;&#x9;&#x9;)&#xA;&#xA;&#xA;&#x9;&#x9;--Incrementamos en 1 dia la fecha&#xA;&#x9;&#x9;SELECT @FECHA_DESDE = DATEADD(DAY, 1, @FECHA_DESDE)&#xA;&#x9;END&#xA;&#xA;&#x9;COMMIT TRANSACTION&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
