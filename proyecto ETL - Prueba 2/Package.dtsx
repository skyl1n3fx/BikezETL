              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
	DIM_TERRITORIO.Id AS "ID_TERRITORIO",
	DIM_CLIENTE.Id AS "ID_CLIENTE",
	DIM_EMPLEADO.Id AS "ID_EMPLEADO",
	DIM_PRODUCTO.Id AS "ID_PRODUCTO",
	DIM_TIEMPO.TiempoID AS "ID_TIEMPO",
	DETALLE_REL.Cantidad AS "CANTIDAD",
	VENTAS_REL.Fecha AS "FECHA",
	VENTAS_REL.FechaEnvio AS "FECHA _ENVIO",
	DETALLE_REL.PrecioUnitario * DETALLE_REL.Cantidad AS "TOTAL_VENTAS"

FROM BikeZ.dbo.Ventas AS VENTAS_REL
INNER JOIN BikeZ.dbo.Territorios AS TERRITORIO_REL ON (TERRITORIO_REL.TerritorioID = VENTAS_REL.TerritorioID )
INNER JOIN BikeZ.dbo.Paises as PAIS_REL ON (TERRITORIO_REL.PaisID = PAIS_REL.PaisID)
INNER JOIN BikeZ.dbo.Almacenes ALMACEN_REL ON  (TERRITORIO_REL.TerritorioID = ALMACEN_REL.TerritorioID)
INNER JOIN BikeZ.dbo.DetalleVentas AS DETALLE_REL ON (VENTAS_REL.VentaID = DETALLE_REL.VentaID)
INNER JOIN BikeZ.dbo.Productos AS PRODUCTO_REL ON (DETALLE_REL.ProductoID = PRODUCTO_REL.ProductoID)
INNER JOIN BikeZ.dbo.Categorias AS CATEGORIA_REL ON (PRODUCTO_REL.CategoriaID = CATEGORIA_REL.CategoriaID)
INNER JOIN BikeZ.dbo.Clientes AS CLIENTE_REL ON (VENTAS_REL.ClienteID = CLIENTE_REL.ClienteID)
INNER JOIN BikeZ.dbo.Empleados as EMPLEADO_REL ON (VENTAS_REL.VendedorID = EMPLEADO_REL.EmpleadoID)

INNER JOIN BikeZ_DW.dbo.DIM_TERRITORIO AS DIM_TERRITORIO ON (DIM_TERRITORIO.TerritorioID = TERRITORIO_REL.TerritorioID)
INNER JOIN BikeZ_DW.dbo.DIM_PRODUCTO AS DIM_PRODUCTO ON (DIM_PRODUCTO.ProductoID = PRODUCTO_REL.ProductoID)
INNER JOIN BikeZ_DW.dbo.DIM_CLIENTE AS DIM_CLIENTE ON (DIM_CLIENTE.ClienteID = CLIENTE_REL.ClienteID)
INNER JOIN BikeZ_DW.dbo.DIM_TIEMPO AS DIM_TIEMPO ON (DIM_TIEMPO.Fecha = VENTAS_REL.Fecha)
INNER JOIN Bikez_DW.dbo.DIM_EMPLEADO AS DIM_EMPLEADO ON (DIM_EMPLEADO.EmpleadoID = EMPLEADO_REL.EmpleadoID)


WHERE VENTAS_REL.VendedorID IS NOT NULL</property>
